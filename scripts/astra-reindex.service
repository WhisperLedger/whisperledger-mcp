[Unit]
Description=Astra daily re-index of all indexed repos
After=network-online.target docker.service
Wants=network-online.target
OnFailure=astra-failure-notify@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/jarvis/scripts
ExecStart=/home/ubuntu/jarvis/scripts/reindex_all.sh
# 4-hour ceiling. Was 2400s (40min) until 2026-05-19 — that was sized for the
# code-only reindex (~16min). After pr_indexer --all was added to the script
# (commit 437dd87, 2026-05-17), combined runs hit ~45-60min due to per-repo
# `gh api` latency across ~250 repos. The 40min ceiling caused silent SIGTERM
# kills two nights running before being noticed.
TimeoutStartSec=14400
StandardOutput=append:/home/ubuntu/jarvis/logs/reindex.log
StandardError=append:/home/ubuntu/jarvis/logs/reindex.log
Nice=10

[Install]
WantedBy=multi-user.target
