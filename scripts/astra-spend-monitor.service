[Unit]
OnFailure=jarvis-failure-notify@%n.service
Description=Jarvis spend monitor - credit-failure + threshold alerts

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/jarvis/scripts
ExecStart=/home/ubuntu/jarvis/scripts/run_spend_monitor.sh
StandardOutput=append:/home/ubuntu/jarvis/logs/spend_monitor.log
StandardError=append:/home/ubuntu/jarvis/logs/spend_monitor.log
