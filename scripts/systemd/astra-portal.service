[Unit]
Description=Jarvis Developer Portal (Google OAuth + API key management)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/jarvis/scripts
ExecStart=/home/ubuntu/jarvis/scripts/run_portal.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
OnFailure=jarvis-failure-notify@%n.service

[Install]
WantedBy=multi-user.target
