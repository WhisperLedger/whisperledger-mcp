[Unit]
Description=Jarvis daily open-PR aging digest → #technology-team
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/home/ubuntu/jarvis/scripts/run_open_pr_digest.sh
StandardOutput=append:/home/ubuntu/jarvis/logs/open_pr_digest.log
StandardError=append:/home/ubuntu/jarvis/logs/open_pr_digest.log
OnFailure=jarvis-failure-notify@%n.service

[Install]
WantedBy=multi-user.target
