[Unit]
Description=Jarvis MCP server (streamable-http on 127.0.0.1:8082)
After=network.target jarvis-api.service
# Soft dep on jarvis-api since Phase 3 trigger tools POST to it locally
Wants=jarvis-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/jarvis/scripts
ExecStart=/home/ubuntu/jarvis/scripts/run_mcp_server.sh --transport=http
Restart=on-failure
RestartSec=5s
# CRITICAL: never use EnvironmentFile= here — env file is shell-source format
# (feedback_systemd_env_pattern.md). run_mcp_server.sh sources it correctly.

# Failure notification (uses the same hook other Jarvis services use)
OnFailure=jarvis-failure-notify@%n.service

# Resource limits — modest; this process is mostly I/O bound
LimitNOFILE=4096

# Log to journal (bypass any stderr piping)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-mcp

[Install]
WantedBy=multi-user.target
