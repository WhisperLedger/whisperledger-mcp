[Unit]
Description=Jarvis alert — Slack notification when %i fails
# This is a templated unit. Other Jarvis services reference it via:
#   OnFailure=jarvis-failure-notify@%n.service
# %i in this template is the failed unit name (e.g. "jarvis-reindex.service").

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/jarvis/scripts
ExecStart=/home/ubuntu/jarvis/scripts/notify_failure.sh %i
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30
