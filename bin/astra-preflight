#!/usr/bin/env bash
# jarvis-preflight — local pre-push PR review via Jarvis
set -euo pipefail

CONFIG_FILE="${HOME}/.astra/config"
if [ ! -f "$CONFIG_FILE" ] && [ -f "${HOME}/.jarvis/config" ]; then
    CONFIG_FILE="${HOME}/.jarvis/config"
fi

BASE_BRANCH=""; USE_COLOR="auto"; RAW_JSON=0
while [ $# -gt 0 ]; do
    case "$1" in
        --base)     BASE_BRANCH="$2"; shift 2 ;;
        --no-color) USE_COLOR="never"; shift ;;
        --json)     RAW_JSON=1; shift ;;
        -h|--help)  sed -n '2,11p' "$0" | sed 's|^# \?||'; exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 3 ;;
    esac
done

if [ ! -f "$CONFIG_FILE" ]; then
    echo "First run — creating ${CONFIG_FILE}" >&2
    mkdir -p "${HOME}/.astra"
    read -p "Astra endpoint URL [http://localhost:8081]: " ENDPOINT
    ENDPOINT="${ENDPOINT:-http://localhost:8081}"
    read -p "ASTRA_API_KEY: " TOKEN
    cat > "$CONFIG_FILE" <<EOF
endpoint=${ENDPOINT}
token=${TOKEN}
EOF
    chmod 600 "$CONFIG_FILE"
fi
ENDPOINT=$(grep '^endpoint=' "$CONFIG_FILE" | cut -d= -f2-)
TOKEN=$(grep '^token=' "$CONFIG_FILE" | cut -d= -f2-)
[ -z "$ENDPOINT" ] || [ -z "$TOKEN" ] && { echo "Missing endpoint or token in $CONFIG_FILE" >&2; exit 3; }

git rev-parse --git-dir >/dev/null 2>&1 || { echo "Not inside a git repo" >&2; exit 3; }
ORG=$(git remote get-url origin 2>/dev/null | sed -nE 's|.*[/:]([a-zA-Z0-9_-]+)/[^/.]+(\.git)?$|\1|p')
REPO=$(git remote get-url origin 2>/dev/null | sed -nE 's|.*[/:][a-zA-Z0-9_-]+/([^/.]+)(\.git)?$|\1|p')
[ -z "$REPO" ] && { echo "Could not derive repo name from origin remote" >&2; exit 3; }

if [ -z "$BASE_BRANCH" ]; then
    for candidate in main master develop; do
        if git rev-parse --verify "origin/$candidate" >/dev/null 2>&1; then
            BASE_BRANCH="$candidate"; break
        fi
    done
    [ -z "$BASE_BRANCH" ] && { echo "Could not auto-detect base branch (--base <branch>)" >&2; exit 3; }
fi

DIFF=$(git diff "origin/${BASE_BRANCH}...HEAD" 2>/dev/null || git diff "${BASE_BRANCH}...HEAD")
[ -z "$DIFF" ] && { echo "No diff vs origin/${BASE_BRANCH} — nothing to preflight" >&2; exit 4; }
DIFF_LINES=$(echo "$DIFF" | wc -l | tr -d ' ')
DIFF_CHARS=${#DIFF}

if [ "$USE_COLOR" = "auto" ]; then
    [ -t 1 ] && USE_COLOR="always" || USE_COLOR="never"
fi
if [ "$USE_COLOR" = "always" ]; then
    C_RESET=$'\e[0m'; C_BOLD=$'\e[1m'; C_DIM=$'\e[2m'
    C_RED=$'\e[31m'; C_YELLOW=$'\e[33m'; C_BLUE=$'\e[34m'; C_GREEN=$'\e[32m'; C_CYAN=$'\e[36m'
else
    C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_YELLOW=""; C_BLUE=""; C_GREEN=""; C_CYAN=""
fi

REQUESTER="${USER:-cli}@$(hostname -s 2>/dev/null || echo unknown)"
echo "${C_DIM}Preflighting ${ORG}/${REPO} vs origin/${BASE_BRANCH} (${DIFF_LINES} lines, ${DIFF_CHARS} chars)...${C_RESET}" >&2

# Build payload via heredoc so stdin to python is the diff, not script
PAYLOAD=$(python3 -c "import json,sys; print(json.dumps({'repo': sys.argv[1], 'diff': sys.stdin.read(), 'requester': sys.argv[2]}))" "$REPO" "$REQUESTER" <<< "$DIFF")

# Write response to a tempfile to avoid stdin conflicts with the renderer below
RESPONSE_FILE=$(mktemp -t preflight-resp.XXXXXX)
trap 'rm -f "$RESPONSE_FILE"' EXIT
START=$(date +%s)
HTTP_CODE=$(curl -sS --max-time 240 \
    -o "$RESPONSE_FILE" -w "%{http_code}" \
    -X POST "${ENDPOINT}/api/v1/preflight" \
    -H "Authorization: Bearer ${TOKEN}" \
    -H "Content-Type: application/json" \
    -d "$PAYLOAD") || { echo "HTTP request failed" >&2; exit 3; }
ELAPSED=$(($(date +%s) - START))

if [ "$RAW_JSON" = "1" ]; then cat "$RESPONSE_FILE"; exit 0; fi

if [ "$HTTP_CODE" != "200" ]; then
    echo "HTTP $HTTP_CODE — server response:" >&2
    cat "$RESPONSE_FILE" >&2
    exit 3
fi

# Render: pass response file path + colors as args (no stdin conflict)
python3 - "$RESPONSE_FILE" "$C_RESET" "$C_BOLD" "$C_DIM" "$C_RED" "$C_YELLOW" "$C_BLUE" "$C_GREEN" "$C_CYAN" "$ELAPSED" <<'RENDERER'
import json, sys
response_file, RESET, BOLD, DIM, RED, YELLOW, BLUE, GREEN, CYAN, ELAPSED = sys.argv[1:]
with open(response_file) as f:
    d = json.load(f)
if not d.get("ok"):
    print(f"{RED}{BOLD}Preflight failed:{RESET} {d.get('error','?')}", file=sys.stderr); sys.exit(3)
summary = d.get("summary") or {}; findings = d.get("findings") or []
risk = d.get("risk_assessment", "?"); cost = d.get("cost_usd", 0); sev_dur = d.get("duration_sec", 0)
risk_color = {"HIGH": RED, "MEDIUM": YELLOW, "LOW": GREEN}.get(risk, "")
print()
print(f"  {BOLD}Risk: {risk_color}{risk}{RESET}  •  {summary.get('critical',0)} critical, {summary.get('high',0)} high, {summary.get('medium',0)} medium, {summary.get('low',0)} low, {summary.get('info',0)} info  •  {DIM}${cost:.3f}, {sev_dur}s server / {ELAPSED}s total{RESET}")
print()
SEV_ORDER = {"critical": 0, "high": 1, "medium": 2, "low": 3, "info": 4}
SEV_COLOR = {"critical": RED, "high": YELLOW, "medium": BLUE, "low": CYAN, "info": DIM}
findings.sort(key=lambda f: SEV_ORDER.get(f.get("severity",""), 9))
for f in findings:
    sev = f.get("severity","?"); color = SEV_COLOR.get(sev, "")
    file = f.get("file","?"); line = f.get("line")
    where = f"{file}:{line}" if line else file
    print(f"  {color}{BOLD}[{sev.upper()}]{RESET} {BOLD}{where}{RESET}  ({f.get('category','?')})")
    print(f"    {BOLD}{f.get('title','?')}{RESET}")
    for ln in (f.get("body","")).split("\n"):
        print(f"    {DIM}{ln}{RESET}")
    print()
if any(f.get("severity") == "critical" for f in findings): sys.exit(2)
if any(f.get("severity") == "high" for f in findings): sys.exit(1)
sys.exit(0)
RENDERER
